ARG BUILD_IMAGE
ARG BASE_IMAGE
FROM ${BUILD_IMAGE} AS build
RUN dnf -y install cargo rust gcc-c++ clang clang-devel cmake make perl pkgconf-pkg-config openssl-devel git curl && dnf clean all
WORKDIR /build
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_TARGET_DIR=/build/target/avx2-v1
COPY . .
RUN --mount=type=cache,id=rustle-cargo-fedora43-v1,target=/root/.cargo --mount=type=cache,id=rustle-target-fedora43-avx2-v1,target=/build/target \
    cargo build --locked --release --bin rustle && \
    make stage TARGET_DIR="$CARGO_TARGET_DIR" DESTDIR=/candidate PREFIX=/usr && \
    mkdir -p target/release && cp "$CARGO_TARGET_DIR/release/rustle" target/release/rustle && \
    cargo install --locked --version 0.21.0 cargo-generate-rpm && cargo generate-rpm -o /candidate/rustle.rpm && \
    tar -czf /candidate/rustle.tar.gz -C /candidate usr && \
    sha256sum /candidate/rustle.tar.gz > /candidate/rustle.tar.gz.sha256

FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]
COPY tests/desktop/hyprland.repo /tmp/rustle-hyprland.repo
RUN source /etc/os-release; \
    if [[ "$ID" == arch ]]; then \
      pacman -Syu --noconfirm --needed systemd dbus pipewire pipewire-audio pipewire-pulse wireplumber libpulse \
        hyprland uwsm seatd mesa libglvnd flatpak python python-gobject gtk3 waybar mako foot \
        curl xdg-utils desktop-file-utils base-devel sudo; \
    else \
      install -m 0644 /tmp/rustle-hyprland.repo /etc/yum.repos.d/rustle-hyprland.repo; \
      dnf -y install systemd systemd-pam dbus-daemon pipewire pipewire-utils pipewire-pulseaudio wireplumber pulseaudio-utils \
        hyprland uwsm seatd mesa-dri-drivers mesa-libEGL flatpak python3 python3-gobject gtk3 waybar mako foot \
        curl xdg-utils desktop-file-utils shadow-utils sudo; \
      dnf clean all; \
    fi
COPY --from=build /candidate /candidate
COPY scripts/verify-install.py scripts/package-arch.sh /opt/rustle-test/
COPY tests/desktop /opt/rustle-test/desktop
RUN useradd -m -u 1000 tester; \
    printf 'account required pam_permit.so\nsession required pam_systemd.so\n' >/etc/pam.d/rustle-test; \
    source /etc/os-release; \
    if [[ "$ID" == arch ]]; then \
      install -d -o tester -g tester /tmp/rustle-package; \
      runuser -u tester -- bash /opt/rustle-test/package-arch.sh /candidate/rustle.tar.gz /tmp/rustle-package; \
      pacman -U --noconfirm /tmp/rustle-package/*.pkg.tar.zst; \
      cp /tmp/rustle-package/*.pkg.tar.zst /candidate/; \
    else \
      dnf -y install /candidate/rustle.rpm; \
    fi; \
    install -d -m 0755 /artifacts /models; \
    chown -R tester:tester /artifacts /models; \
    systemctl mask --force systemd-udevd.service systemd-udevd-control.socket systemd-udevd-kernel.socket \
      systemd-resolved.service sddm.service display-manager.service system-flatpak-setup.service; \
    systemctl enable user@1000.service
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
